# Clean Ubuntu 24.04 environment for building SchedMD's Slurm .debs (handbook Ch18).
# Only generic tooling is baked in. Slurm's own Build-Depends come from its debian/control
# and are installed in a fresh container for every build (apt-get build-dep), as in Ch15.
# Base pinned by manifest-list digest: the same ubuntu:24.04 as Ch15's builder.
FROM docker.io/library/ubuntu:24.04@sha256:534baea6a22c03a63003dbc8dbe78fe34bc0d7e595d9a9dc9834884ff530eb55

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends build-essential dpkg-dev fakeroot bzip2 lintian \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /build
